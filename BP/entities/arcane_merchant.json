{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "mcpp:arcane_merchant",
      "runtime_identifier": "minecraft:witch",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "components": {
      "minecraft:type_family": { "family": ["mcpp_merchant", "villager", "mob"] },
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:collision_box": { "width": 0.6, "height": 1.9 },
      "minecraft:movement": { "value": 0.12 },
      "minecraft:navigation.walk": { "can_path_over_water": false, "avoid_water": true },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:nameable": { "always_show": true, "allow_name_tag_renaming": true },
      "minecraft:persistent": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.25
      },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 2,
        "entity_types": [
          {
            "filters": { "test": "is_family", "subject": "other", "value": "monster" },
            "max_dist": 12,
            "walk_speed_multiplier": 0.8,
            "sprint_speed_multiplier": 1.25
          }
        ]
      },
      "minecraft:behavior.look_at_player": {
        "priority": 5,
        "look_distance": 8,
        "probability": 0.08
      },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 0.6
      },
      "minecraft:behavior.random_look_around": { "priority": 8 }
    }
  }
}
